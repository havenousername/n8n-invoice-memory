    {
      "id": "07455c3f-e767-5e7c-9642-7504e2eba13d",
      "name": "Prepare the vision request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "const VISION_REQUEST_TEMPLATE = {\"model\": \"\", \"temperature\": 0, \"max_tokens\": 400, \"response_format\": {\"type\": \"json_schema\", \"json_schema\": {\"name\": \"invoice\", \"strict\": true, \"schema\": {\"type\": \"object\", \"properties\": {\"invoice_no\": {\"type\": \"string\"}, \"date\": {\"type\": \"string\", \"description\": \"YYYY-MM-DD\"}, \"due_date\": {\"type\": \"string\", \"description\": \"YYYY-MM-DD\"}, \"amount\": {\"type\": \"number\", \"description\": \"total in EUR\"}, \"vendor\": {\"type\": \"string\"}, \"customer_name\": {\"type\": \"string\"}, \"status\": {\"type\": \"string\", \"enum\": [\"open\", \"paid\", \"overdue\"]}, \"line_items_summary\": {\"type\": \"string\", \"description\": \"max 12 words\"}}, \"required\": [\"invoice_no\", \"date\", \"due_date\", \"amount\", \"vendor\", \"customer_name\", \"status\", \"line_items_summary\"], \"additionalProperties\": false}}}, \"plugins\": [{\"id\": \"file-parser\", \"pdf\": {\"engine\": \"\"}}], \"messages\": [{\"role\": \"system\", \"content\": \"You read one invoice PDF and return JSON only with keys: invoice_no, date (YYYY-MM-DD), due_date (YYYY-MM-DD), amount (number in EUR, no thousands separators), vendor, customer_name, status (one of: open, paid, overdue), line_items_summary (max 12 words).\"}, {\"role\": \"user\", \"content\": [{\"type\": \"text\", \"text\": \"Extract the fields.\"}, {\"type\": \"file\", \"file\": {\"filename\": \"invoice.pdf\", \"file_data\": \"data:application/pdf;base64,\"}}]}]};\n// Glue for \"Prepare the vision request\" in 02 Process. build_workflows.py injects VISION_REQUEST_TEMPLATE above it:\n// scripts/openrouter_check.py's extraction_body with an empty PDF, so n8n sends the request the live gate tested.\n// The binary passes through for \"Pull the text out of the PDF\".\nconst cfg = $('Config').first().json;\nconst pdf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst body = JSON.parse(JSON.stringify(VISION_REQUEST_TEMPLATE));\nbody.model = cfg.OPENROUTER_MODEL;\nbody.plugins[0].pdf.engine = cfg.PDF_ENGINE;\nbody.messages[1].content.find((part) => part.type === 'file').file.file_data += pdf.toString('base64');\nreturn [{ json: { body }, binary: $input.first().binary }];\n"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "61cb6573-6fec-535c-94ea-262cec68ec7b",
      "name": "Pull the text out of the PDF",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "data",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "bcd3501a-b461-5e19-af0f-85eed107e2e9",
      "name": "Coarse read with regex",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "// Stage 1: a regex read of the extracted PDF text. Pasted into n8n Code nodes without the module.exports line.\n// ponytail: deliberately naive. \"4,250.00\" parses right, \"12.300,00\" parses as 12.3; the vision stage corrects it.\n\nfunction coarseRead(text) {\n  const t = text || '';\n  const grab = (re) => {\n    const m = t.match(re);\n    return m ? m[1].trim() : null;\n  };\n  const rawTotal = grab(/total[^0-9]*([0-9][0-9.,]*)/i);\n  return {\n    invoice_no: grab(/invoice\\s*(?:no\\.?|number|#)\\s*[:#]?\\s*([A-Z0-9-]+)/i),\n    date: grab(/(?<!due\\s)date\\s*:?\\s*(\\d{4}-\\d{2}-\\d{2})/i),\n    due_date: grab(/due\\s*(?:date)?\\s*:?\\s*(\\d{4}-\\d{2}-\\d{2})/i),\n    amount: rawTotal === null ? null : parseFloat(rawTotal.replace(/,/g, '')),\n    vendor: grab(/from\\s*:?\\s*([^\\n]+)/i),\n  };\n}\n\n// Glue for \"Coarse read with regex\" in 02 Process; coarse.js is pasted above it. Empty text (a scanned PDF) is valid.\nconst text = $json.text || '';\nreturn [{ json: { regex_fields: JSON.stringify(coarseRead(text)), text } }];\n"
      }
    },
