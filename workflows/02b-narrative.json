    {
      "id": "974019d6-a7ed-5c6b-a926-3601d4156792",
      "name": "Hash the point id",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.manager_id }}/{{ $json.customer_id }}",
        "dataPropertyName": "idhash",
        "encoding": "hex"
      }
    },
    {
      "id": "b520a71f-67eb-5660-b3c1-2768d6150a93",
      "name": "Format the point id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Point ids and upload identity. Pasted into n8n Code nodes without the module.exports line.\n\nfunction uuidFromHex(hex) {\n  if (typeof hex !== 'string' || !/^[0-9a-f]{32,}$/i.test(hex)) {\n    throw new Error(`expected a sha-256 hex digest, got ${hex}`);\n  }\n  const h = hex.toLowerCase();\n  return `${h.slice(0, 8)}-${h.slice(8, 12)}-4${h.slice(13, 16)}-8${h.slice(17, 20)}-${h.slice(20, 32)}`;\n}\n\nfunction resolveUpload(sampleFile, workerId, workers) {\n  const slug = String(sampleFile).replace(/\\.pdf$/i, '').split('-')[0].toLowerCase();\n  if (!slug) throw new Error(`no customer slug in ${sampleFile}`);\n  if (!Object.hasOwn(workers, workerId)) throw new Error(`unknown worker ${workerId}`);\n  return { customer_id: slug, worker_id: workerId, manager_id: workers[workerId].manager_id };\n}\n\n// Glue for \"Format the point id\" in 02b Write the narrative; ids.js is pasted above it.\nconst cfg = $('Config').first().json;\nconst id = uuidFromHex($json.idhash);\nreturn [{ json: { id, body: { shard_key: cfg.manager_id, ids: [id], with_payload: true } } }];\n"
      }
    },
    {
      "id": "1e685ef4-b7c6-5566-aeea-92eb010f9eab",
      "name": "Read the point",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.QDRANT_URL }}/collections/{{ $('Config').first().json.COLLECTION }}/points",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Qdrant api-key"
        }
      }
    },
    {
      "id": "9abab9f3-88e0-5164-8a7c-eead08e146ce",
      "name": "Prepare the narrative snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Glue for \"Prepare the narrative snapshot\" in 02b Write the narrative.\n// Only a sharp point is narrated: every invoice read by the vision stage, none pending. The payload travels on,\n// so the narrative is saved with the source_revision it was written from and goes stale if the rows change.\nconst cfg = $('Config').first().json;\nconst payload = (($json.result || [])[0] || {}).payload;\nif (!payload || payload.manager_id !== cfg.manager_id || payload.customer_id !== cfg.customer_id) {\n  throw new Error(`missing tenant point for ${cfg.manager_id}/${cfg.customer_id}`);\n}\nif (payload.stage !== 2 || payload.pending_count !== 0) return [];\nconst { invoice_count, open_amount, overdue_count, overdue_amount, last_invoice_at } = payload;\nconst aggregates = { invoice_count, open_amount, overdue_count, overdue_amount, last_invoice_at };\nconst lines = payload.invoices.map((i) => `${i.invoice_no} | ${i.date} | ${i.amount} EUR | due ${i.due_date} | ${i.status} | ${i.items}`);\nconst body = {\n  model: cfg.OPENROUTER_MODEL,\n  temperature: 0,\n  max_tokens: 300,\n  response_format: { type: 'json_schema', json_schema: { name: 'narrative', strict: true, schema: {\n    type: 'object', additionalProperties: false, required: ['narrative'], properties: { narrative: { type: 'string' } },\n  } } },\n  messages: [\n    { role: 'system', content: 'You write for a manager. Three plain sentences about this customer: what is open, what is overdue, what changed most recently. No bullet points.' },\n    { role: 'user', content: `Aggregates: ${JSON.stringify(aggregates)}\\nInvoices:\\n${lines.join('\\n')}` },\n  ],\n};\nreturn [{ json: { payload, body } }];\n"
      }
    },
    {
      "id": "60d4cc18-f2f7-5a0e-918d-d8f979ce0e2f",
      "name": "Ask for three sentences",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "OpenRouter bearer"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "24bd388d-4255-510b-8800-d2fc73296411",
      "name": "Keep only the narrative",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "jsCode": "// Glue for \"Keep only the narrative\" in 02b Write the narrative. A bad reply stops the run: the point stays at rung 2.\nlet reply;\ntry {\n  reply = JSON.parse($json.choices[0].message.content);\n} catch {\n  throw new Error('narrative reply is not bare JSON');\n}\nif (!reply || typeof reply.narrative !== 'string' || reply.narrative.length < 20) throw new Error('bad narrative');\nconst revision = $('Prepare the narrative snapshot').first().json.payload.source_revision;\nconst at = new Date().toISOString().replace(/\\.\\d{3}Z$/, 'Z');\nreturn [{ json: { narrative: reply.narrative.slice(0, 600), at, revision } }];\n"
      }
    },
    {
      "id": "8cc704d6-b8d8-521b-a7de-93c628d75bd7",
